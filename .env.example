# ==============================================================================
# TRACE - Environment Variables & Provider Configuration (Template)
# ==============================================================================
# DO NOT put real API keys or sensitive credentials in this file.
# Copy this file to .env.local for local development if configuring an external AI provider.
# All user data in TRACE is local-first (stored in IndexedDB / chrome.storage).
# ==============================================================================

# Active AI Provider: 'stub' | 'openai' | 'anthropic' | 'local' | 'chrome-prompt'
TRACE_AI_PROVIDER=stub

# Optional API Keys (Only stored locally in .env.local, NEVER committed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Model Endpoint (e.g. Ollama, LM Studio)
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=llama3.2
